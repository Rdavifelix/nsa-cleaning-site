{
  "name": "nsa-cleaning-site",
  "version": "1.0.0",
  "private": true,
  "description": "NSA Cleaning LLC \u2014 static marketing site (Albany to Lake George, NY)",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "check": "node scripts/check-links.mjs && node scripts/check-copy.mjs src && node scripts/check-seo.mjs",
    "lint:copy": "node scripts/check-copy.mjs src",
    "check:seo": "node scripts/check-seo.mjs",
    "cities": "python3 scripts/gen_cities.py",
    "deploy": "bash scripts/deploy.sh",
    "deploy:dry": "bash scripts/deploy.sh --dry",
    "indexnow": "node scripts/indexnow.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "html-validate": "^11.15.0",
    "lighthouse": "^13.4.1",
    "puppeteer-core": "^25.10.0"
  }
}
