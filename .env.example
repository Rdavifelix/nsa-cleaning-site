# ---- Build-time (public, baked into HTML) ----
# Final public URL of the site, no trailing slash. Overrides site.config.json → siteUrl
SITE_URL=https://lp.nsacleaning.com
# Google Analytics 4 measurement ID (loaded only after cookie consent)
GA_MEASUREMENT_ID=
# Cloudflare Turnstile SITE key (public). Leave empty to disable the widget.
TURNSTILE_SITE_KEY=

# ---- Server-side only (NEVER shipped to the browser; set in Vercel → Settings → Environment Variables) ----
# Cloudflare Turnstile SECRET key. If set, every quote submission must carry a valid token.
TURNSTILE_SECRET_KEY=
# Email provider #1: Resend (https://resend.com) — API key
RESEND_API_KEY=
# From address for Resend. Must be on a verified domain, e.g. quotes@nsacleaningllc.com
# (until a domain is verified, onboarding@resend.dev only delivers to the Resend account owner's email)
QUOTE_FROM_EMAIL=NSA Cleaning Website <onboarding@resend.dev>
# Email provider #2 (fallback if RESEND_API_KEY is empty): Web3Forms access key (https://web3forms.com)
WEB3FORMS_ACCESS_KEY=
# Where quote requests are delivered (comma-separated allowed)
QUOTE_TO_EMAIL=Nsacleaningllc@gmail.com
