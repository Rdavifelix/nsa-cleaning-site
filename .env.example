# ---- Build-time (public, baked into HTML) ----
# Final public URL of the site, no trailing slash. Overrides site.config.json → siteUrl
SITE_URL=https://lp.nsacleaningllc.com
# Google Analytics 4 measurement ID (loaded only after cookie consent)
GA_MEASUREMENT_ID=
# GoHighLevel chat widget id. Overrides site.config.json → ghlChatWidgetId
GHL_CHAT_WIDGET_ID=
